{
  "name": "instatic",
  "private": true,
  "version": "0.0.21",
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@10.33.0",
  "description": "Self-hosted CMS with an integrated visual editor.",
  "author": "David Babinec",
  "license": "MIT",
  "homepage": "https://instatic.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/corebunch/instatic.git"
  },
  "bugs": {
    "url": "https://github.com/corebunch/instatic/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:agent": "pnpm run dev:server",
    "dev:server": "tsx watch server/index.ts",
    "dev:vite": "vite",
    "e2e:dev": "tsx scripts/e2e-dev.ts",
    "db:drop": "tsx scripts/db-drop.ts",
    "start": "tsx scripts/start.ts",
    "serve": "node --import tsx server/index.ts",
    "docker:up": "docker compose -f compose.prod.yml -f compose.build.yml up --build",
    "release:bundle": "tsx scripts/build-release-bundle.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint . --cache --cache-location .tmp-lint/eslint-cache",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "test:bundle": "pnpm run build && vitest run src/__tests__/architecture/bundle-size-budgets.test.ts",
    "test:coverage": "vitest run --coverage",
    "fallow:health": "pnpm run test:coverage && pnpm dlx fallow health --coverage .coverage/coverage-final.json",
    "icons:sync": "tsx scripts/sync-icons.ts",
    "icons:check": "tsx scripts/sync-icons.ts --check",
    "bootstrap:sync": "tsx scripts/sync-plugin-bootstrap.ts",
    "bootstrap:check": "tsx scripts/sync-plugin-bootstrap.ts --check",
    "instatic-plugin": "tsx src/core/plugin-sdk/cli/index.ts",
    "bench": "tsx scripts/bench/index.ts",
    "bench:bundle": "tsx scripts/bench/index.ts --only=bundle",
    "bench:publisher": "tsx scripts/bench/index.ts --only=publisher",
    "bench:publish": "tsx scripts/bench/index.ts --only=publish",
    "bench:editor-store": "tsx scripts/bench/index.ts --only=editor-store",
    "bench:http": "tsx scripts/bench/index.ts --only=http",
    "bench:db": "tsx scripts/bench/index.ts --only=db",
    "bench:plugin": "tsx scripts/bench/index.ts --only=plugin",
    "bench:footprint": "tsx scripts/bench/index.ts --only=footprint",
    "bench:health": "tsx scripts/bench/index.ts --only=health",
    "bench:browser": "tsx scripts/bench/index.ts --only=browser",
    "bench:browser:install": "playwright install chromium",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/state": "^6.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@node-rs/argon2": "^2.2.2",
    "@sinclair/typebox": "^0.34.49",
    "@tiptap/core": "^3",
    "@tiptap/extension-table": "^3",
    "@tiptap/extension-table-cell": "^3",
    "@tiptap/extension-table-header": "^3",
    "@tiptap/extension-table-row": "^3",
    "@tiptap/extension-text-align": "^3",
    "@tiptap/extensions": "^3",
    "@tiptap/pm": "^3",
    "@tiptap/react": "^3",
    "@tiptap/starter-kit": "^3",
    "@tiptap/suggestion": "^3",
    "@use-gesture/react": "^10.3.1",
    "better-sqlite3": "^13.0.3",
    "blurhash": "^2.0.5",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.2",
    "esbuild": "^0.28.0",
    "fflate": "^0.8.2",
    "happy-dom": "^20.9.0",
    "html-to-image": "^1.11.13",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^30.0.1",
    "lib0": "^0.2.117",
    "lru-cache": "^11.3.5",
    "marked": "^18.0.3",
    "mutative": "^1.3.0",
    "nanoid": "^5.1.11",
    "pixel-art-icons": "file:./vendor/pixel-art-icons",
    "postgres": "^3.4.9",
    "quickjs-emscripten": "^0.32.0",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "semver": "^7.7.4",
    "sharp": "^0.35.0",
    "srvx": "^1.0.5",
    "tsx": "^4.23.15",
    "undici": "^7.30.0",
    "uqr": "^0.1.3",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zustand": "^5.0.12",
    "zustand-mutative": "^1.3.1"
  },
  "devDependencies": {
    "@codemirror/view": "^6.41.1",
    "@eslint/js": "^10.0.1",
    "@floating-ui/dom": "^1.7.6",
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.60.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@secretlint/secretlint-rule-preset-recommend": "^12.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jscpd": "^4.0.9",
    "knip": "^6.11.0",
    "madge": "^8.0.0",
    "playwright-core": "^1.60.0",
    "react-doctor": "^0.2.14",
    "secretlint": "^12.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^5.0.4"
  }
}
